{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Music",
  "version": "1.0.5",
  "identifier": "com.openmusic.desktop",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Music",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica", "acrylic", "blur"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4N0RBNjJFRjY0NjI2N0EKUldSNkprYjJMcVo5MlBCb1hmNlUwWlltSmdSd2c5RWJ0dGRsdDVBRnFDRHVKczkxd3ZxTFhMc0kK",
      "endpoints": [
        "https://raw.githubusercontent.com/XXXoooM/Open-Music/main/desktop-version.json",
        "https://ghfast.top/https://raw.githubusercontent.com/XXXoooM/Open-Music/main/desktop-version.json"
      ]
    }
  }
}
