{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Music",
  "version": "1.0.5",
  "identifier": "com.openmusic.desktop",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open Music",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica", "acrylic", "blur"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
